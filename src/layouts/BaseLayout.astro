---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  /** Ruta de imagen para compartir en redes (Open Graph) */
  ogImage?: string;
  /** Canonical explícito (ruta absoluta del sitio). Por defecto, la URL actual. */
  canonical?: string;
}

const {
  title,
  description = 'Building Networks: diseño e implementación de redes convergentes, data center, videovigilancia (CamScope), control de acceso, audio IP y conectividad. Córdoba, Argentina.',
  ogImage = '/og-default.jpg',
  canonical: canonicalOverride,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(canonicalOverride ?? Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Favicon de marca (ícono real, sin texto). Es el que Google usa como
         "logo" en los resultados. sizes con los valores REALES de cada archivo
         (antes estaban mal declarados y Google podía descartarlos). -->
    <link rel="icon" href="/wp-content/uploads/2024/07/favicon-300x300.png" type="image/png" sizes="300x300" />
    <link rel="icon" href="/wp-content/uploads/2024/07/favicon-150x150.png" type="image/png" sizes="150x150" />
    <link rel="shortcut icon" href="/wp-content/uploads/2024/07/favicon-300x300.png" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2024/07/favicon-300x300.png" />

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Contenido adicional de <head> por página (p. ej. JSON-LD). -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
