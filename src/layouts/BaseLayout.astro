---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  /** Ruta de imagen para compartir en redes (Open Graph) */
  ogImage?: string;
  /** Canonical explícito (ruta absoluta del sitio). Por defecto, la URL actual. */
  canonical?: string;
  /**
   * Agrega " — Building Networks" al <title> del documento.
   * Las notas del blog lo omiten: en Google la marca es redundante porque el
   * dominio ya aparece al lado, y esos 20 caracteres se comen el título útil.
   * NO afecta a og:title, que siempre lleva la marca (ver abajo).
   */
  brandSuffix?: boolean;
  /**
   * Saca la página del índice de los buscadores. Para prototipos y páginas de
   * uso interno que viven en una URL difícil de adivinar y no están enlazadas
   * desde ningún lado. Acordate de excluirla también del sitemap, en el filter
   * de astro.config.mjs: el noindex solo pide que no la indexen, el sitemap la
   * estaría ofreciendo.
   */
  noindex?: boolean;
}

const {
  title,
  description = 'Building Networks: diseño e implementación de redes convergentes, data center, videovigilancia (CamScope), control de acceso, audio IP y conectividad. Córdoba, Argentina.',
  ogImage = '/og-default.jpg',
  canonical: canonicalOverride,
  brandSuffix = true,
  noindex = false,
} = Astro.props;

// Título CON marca: es el que va a og:title en todas las páginas, porque en un
// enlace compartido (LinkedIn, WhatsApp) la marca es lo único que da contexto
// de quién publica.
const brandedTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
// Título del documento: pierde la marca solo si la página pide brandSuffix={false}.
const fullTitle = title && !brandSuffix ? title : brandedTitle;
const canonical = new URL(canonicalOverride ?? Astro.url.pathname, Astro.site);

// JSON-LD Organization (global, en todas las páginas). Los datos salen de
// site.config para no duplicarlos; subOrganization enlaza con Data Center
// Capitalinas. El FAQPage de /videovigilancia/ se define aparte y no se toca.
const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  url: 'https://buinet.com.ar/',
  logo: new URL('/wp-content/uploads/2024/07/logo.png', Astro.site).href,
  telephone: site.phoneHref,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.countryCode,
  },
  sameAs: [site.social.linkedin, site.social.instagram],
  subOrganization: {
    '@type': 'Organization',
    name: 'Data Center Capitalinas',
    url: 'https://capitalinasdc.com/',
  },
});
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WK29MCTP');</script>
    <!-- End Google Tag Manager -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />}
    <link rel="canonical" href={canonical} />
    <!-- Favicon de marca (ícono real, sin texto). Es el que Google usa como
         "logo" en los resultados. sizes con los valores REALES de cada archivo
         (antes estaban mal declarados y Google podía descartarlos). -->
    <link rel="icon" href="/wp-content/uploads/2024/07/favicon-300x300.png" type="image/png" sizes="300x300" />
    <link rel="icon" href="/wp-content/uploads/2024/07/favicon-150x150.png" type="image/png" sizes="150x150" />
    <link rel="shortcut icon" href="/wp-content/uploads/2024/07/favicon-300x300.png" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2024/07/favicon-300x300.png" />

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={brandedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Datos estructurados: Organization (global, todas las páginas). -->
    <script type="application/ld+json" is:inline set:html={orgLd} />
    <!-- Contenido adicional de <head> por página (p. ej. JSON-LD). -->
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WK29MCTP"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main" class="visually-hidden">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
