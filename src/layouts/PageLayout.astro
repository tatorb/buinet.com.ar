---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  intro?: string;
}
const { title, description, intro } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <section class="page-header">
    <div class="container">
      <h1>{title}</h1>
      {intro && <p class="page-header__intro">{intro}</p>}
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background: var(--color-surface); border-bottom: 1px solid var(--color-border); padding-block: clamp(2rem, 5vw, 3.5rem); }
  .page-header__intro { color: var(--color-muted); font-size: 1.15rem; max-width: 720px; }
  .prose { max-width: 760px; }
  .prose :global(h2) { margin-top: 2rem; }
  .prose :global(img) { border-radius: var(--radius); margin-block: 1.5rem; }
  .prose :global(ul) { padding-left: 1.25rem; }
</style>
