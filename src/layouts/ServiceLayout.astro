---
import { withBase } from '../utils/url';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceHero from '../components/ServiceHero.astro';
import { servicios } from '../data/servicios';

interface Props {
  slug: string;
  title: string;
  resumen: string;
  icono: string;
  description?: string;
}
const { slug, title, resumen, icono, description } = Astro.props;
const otros = servicios.filter((s) => s.slug !== slug);
const heroImg = servicios.find((s) => s.slug === slug)?.hero;

---
<BaseLayout title={title} description={description ?? resumen}>
  <ServiceHero icono={icono} titulo={title} lead={resumen} imagen={heroImg} />

  <section class="section">
    <div class="container svc-body">
      <div class="prose">
        <slot />
      </div>
      <aside class="svc-aside">
        <div class="card">
          <h3>¿Hablamos de tu proyecto?</h3>
          <p>Coordinemos una reunión con un especialista.</p>
          <a class="btn" href={withBase("/contacto/")} style="margin-top:0.75rem">Contactanos <Icon name="arrow" size={16} /></a>
        </div>
        <div class="card">
          <p class="eyebrow">Otros servicios</p>
          <ul class="svc-links">
            {otros.map((s) => <li><a href={withBase(s.href)}>{s.titulo}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-body { display: grid; grid-template-columns: 1.7fr 1fr; gap: 2.5rem; align-items: start; }
  .prose { max-width: 62ch; }
  .prose :global(h2) { margin-top: 2rem; }
  .prose :global(ul) { padding-left: 1.2rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .svc-aside { display: grid; gap: 1.25rem; position: sticky; top: 130px; }
  .svc-links { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.5rem; }
  .svc-links a { font-weight: 600; color: var(--color-primary); }
  @media (max-width: 900px) { .svc-body { grid-template-columns: 1fr; } .svc-aside { position: static; }  }
</style>
