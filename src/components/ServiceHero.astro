---
// Hero de las páginas de servicio. Uno solo para todas.
//
// Forma: la foto del servicio ocupa todo el ancho. Encima, un panel que cubre
// la mitad izquierda con desenfoque y verde de marca, y ahí va el texto. La
// mitad derecha queda limpia, se ve la foto.
//
// Antes cada página escribía su propio hero y el mismo degradé estaba copiado
// en catorce lugares. Ahora el degradé, el desenfoque y el comportamiento en
// pantallas angostas viven acá.
//
// Lo estructurado va por props; todo lo demás (párrafos extra, listas de
// bullets, botones) entra por el slot, que es lo que permite que páginas con
// contenidos distintos compartan el mismo hero.
import Icon from './Icon.astro';

interface Props {
  /** Clave de ícono (ver Icon.astro). Va en la pastilla de arriba. */
  icono: string;
  /** Línea breve sobre el título. Por defecto, la del resto del sitio. */
  eyebrow?: string;
  titulo: string;
  /** Bajada. Si la página necesita más texto, lo manda por el slot. */
  lead?: string;
  /** Foto de fondo. Sin foto, el panel pinta el degradé a ancho completo. */
  imagen?: string;
}

const { icono, eyebrow = 'Servicios y productos', titulo, lead, imagen } = Astro.props;
---
<section class="svch" data-sin-foto={imagen ? undefined : ''}>
  {imagen && <div class="svch__foto" style={`background-image:url("${imagen}")`} aria-hidden="true" />}
  <div class="svch__panel">
    <div class="svch__texto">
      <span class="hero-badge"><Icon name={icono} size={26} /></span>
      <p class="eyebrow svch__eyebrow">{eyebrow}</p>
      <h1>{titulo}</h1>
      {lead && <p class="lead svch__lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .svch {
    position: relative;
    isolation: isolate;
    color: #fff;
    background: var(--teal-dark); /* se ve si la foto no carga */
    overflow: hidden;
  }
  .svch__foto {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
  }

  /* El panel cubre la mitad izquierda. El desenfoque actúa sobre la foto que
     tiene detrás, y el verde encima le da el contraste para leer. */
  .svch__panel {
    position: relative;
    width: 50%;
    min-height: 100%;
    background: linear-gradient(100deg, rgba(0,70,75,0.92) 60%, rgba(0,98,105,0.78));
    display: flex;
    align-items: center;
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    /* Con desenfoque disponible el panel puede ser más transparente: se
       intuye la foto debajo sin que el texto pierda contraste. */
    .svch__panel {
      -webkit-backdrop-filter: blur(16px) saturate(115%);
      backdrop-filter: blur(16px) saturate(115%);
      background: linear-gradient(100deg, rgba(0,70,75,0.80) 60%, rgba(0,98,105,0.62));
    }
  }
  /* Borde difuso: evita el corte recto contra la foto. */
  .svch__panel::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: clamp(40px, 6vw, 110px);
    background: linear-gradient(to right, rgba(0,80,86,0.55), transparent);
    pointer-events: none;
  }

  /* El texto arranca donde arrancaría dentro de .container, para que el hero
     quede alineado con el resto de la página y no pegado al borde. */
  .svch__texto {
    width: 100%;
    max-width: calc(var(--container) / 2 - 1.5rem);
    margin-left: auto;
    padding: clamp(2.6rem, 6vw, 4.6rem) clamp(1.6rem, 3vw, 2.8rem) clamp(2.6rem, 6vw, 4.6rem) 1.5rem;
  }
  .svch h1 { color: #fff; margin-bottom: 1.2rem; }
  .svch__eyebrow { color: #bfe0dd; }
  .svch__lead { color: rgba(255, 255, 255, 0.92); margin-bottom: 0.9rem; }
  /* Lo que llega por el slot hereda el tratamiento sobre fondo oscuro. */
  .svch__texto :global(p) { color: rgba(255, 255, 255, 0.85); }
  .svch__texto :global(.btn) { margin-top: 1.4rem; }
  .svch__texto :global(ul) { list-style: none; padding: 0; margin: 1.1rem 0 0; display: grid; gap: 0.6rem; }
  .svch__texto :global(li) { display: flex; gap: 0.6rem; align-items: flex-start; color: rgba(255, 255, 255, 0.9); }
  /* :global() también en el svg: lo renderiza Icon y lleva su propio hash. */
  .svch__texto :global(li svg) { color: #bfe0dd; flex: none; margin-top: 5px; }

  /* Sin foto no hay nada que desenfocar ni que dejar a la vista. */
  .svch[data-sin-foto] .svch__panel { width: 100%; backdrop-filter: none; -webkit-backdrop-filter: none; background: linear-gradient(160deg, var(--teal-dark), var(--teal)); }
  .svch[data-sin-foto] .svch__panel::after { display: none; }
  .svch[data-sin-foto] .svch__texto { max-width: var(--container); margin-inline: auto; padding-inline: 1.5rem; }

  /* En pantallas angostas la mitad no alcanza para leer, así que el panel
     pasa a cubrir todo el ancho. La foto sigue abajo, atenuada. */
  @media (max-width: 860px) {
    .svch__panel { width: 100%; }
    .svch__panel::after { display: none; }
    .svch__texto { max-width: var(--container); margin-inline: auto; padding-inline: 1.5rem; }
  }
</style>
