---
import { site, nav } from '../site.config';
import Logo from './Logo.astro';
import { withBase } from '../utils/url';
const year = 2026;
const cols = nav.filter((n) => n.href !== '/');
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand-col">
      <a href={withBase('/')} aria-label={site.name} class="site-footer__logo"><Logo height={38} /></a>
      <address>
        <strong>BUILDING NETWORKS</strong><br />
        {site.address.street}<br />
        ({site.address.zip}) {site.address.city} — {site.address.country}
      </address>
      <div class="site-footer__social">
        <a href={site.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.46-.03-3.34-2.03-3.34-2.03 0-2.34 1.59-2.34 3.23V21H9z"/></svg>
        </a>
        <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>

    <nav class="site-footer__nav" aria-label="Navegación del pie">
      <p class="site-footer__heading">Navegación</p>
      <ul>
        {cols.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__contact-col">
      <p class="site-footer__heading">Contacto</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
      <p><a href={withBase('/contacto/')}>Coordinar reunión con un asesor</a></p>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p>© {year} {site.legalName}. Todos los derechos reservados.</p>
      <p><a href={withBase('/politicas-de-privacidad/')}>Políticas de Privacidad</a></p>
    </div>
  </div>
</footer>

<style>
  /* Azul marino de marca (referencia del sitio original), independiente del teal. */
  .site-footer { background: #00293E; color: rgba(255,255,255,0.82); margin-top: 0; }
  .site-footer a { color: var(--color-on-dark); }
  .site-footer a:hover { color: #fff; }
  .site-footer__grid { display: grid; grid-template-columns: 1.6fr 1fr 1.1fr; gap: 2.5rem; padding-block: 3.5rem; }
  .site-footer__logo { display: inline-block; }
  /* El logo original es de color; lo pasamos a blanco puro para el pie oscuro. */
  .site-footer__logo :global(img) { filter: brightness(0) invert(1); }
  .site-footer__brand-col address { font-style: normal; margin-top: 1rem; line-height: 1.7; }
  .site-footer__brand-col strong { color: #fff; }
  .site-footer__social { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .site-footer__social a { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; }
  .site-footer__social a:hover { background: var(--color-accent); border-color: var(--color-accent); }
  .site-footer__heading { color: #fff; font-weight: 700; margin: 0 0 0.9rem; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; }
  .site-footer__nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .site-footer__contact-col p { margin: 0.35rem 0; }
  .site-footer__bottom { border-top: 1px solid rgba(255,255,255,0.1); font-size: 0.85rem; }
  .site-footer__bottom-inner { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; flex-wrap: wrap; }
  @media (max-width: 860px) { .site-footer__grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
