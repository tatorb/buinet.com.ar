---
// Logotipo de Building Networks reconstruido en HTML/SVG (placeholder editable).
// Cuando tengamos el archivo de logo oficial (SVG/PNG), reemplazar este bloque
// por <img src="/logo.svg" ... />. Variante para fondos claros u oscuros.
interface Props {
  variant?: 'dark' | 'light'; // 'dark' = texto oscuro (fondo claro); 'light' = texto blanco
}
const { variant = 'dark' } = Astro.props;
const textColor = variant === 'light' ? '#ffffff' : 'var(--color-primary)';
---
<span class="logo" style={`--logo-text:${textColor}`}>
  <svg class="logo__mark" width="42" height="42" viewBox="0 0 42 42" aria-hidden="true">
    <rect width="42" height="42" rx="10" fill="var(--color-accent)" />
    <text x="50%" y="53%" dominant-baseline="middle" text-anchor="middle"
          font-family="Inter, Arial, sans-serif" font-size="18" font-weight="800" fill="#fff">BN</text>
  </svg>
  <span class="logo__word">
    <strong>BUILDING</strong>
    <em>NETWORKS</em>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .logo__word { display: flex; flex-direction: column; line-height: 1; color: var(--logo-text); }
  .logo__word strong { font-weight: 800; font-size: 1.05rem; letter-spacing: 0.02em; }
  .logo__word em { font-style: normal; font-weight: 600; font-size: 0.82rem; letter-spacing: 0.28em; color: var(--color-accent); }
</style>
