---
// Logo oficial de Building Networks (servido desde /wp-content/uploads en el server).
interface Props { height?: number }
const { height = 34 } = Astro.props;
---
<img
  src="/wp-content/uploads/2024/07/logo.png"
  alt="Building Networks"
  height={height}
  style={`height:${height}px;width:auto`}
  loading="eager"
  decoding="async"
/>
