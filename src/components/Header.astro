---
import { site, nav } from '../site.config';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={site.name}>
      <!-- Reemplazar por el logo real (SVG/PNG) en /public/logo.svg -->
      <span class="brand__mark">BN</span>
      <span class="brand__name">{site.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle__btn" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Menú principal">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
              class={path === item.href ? 'is-active' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 68px; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 700; color: var(--color-fg); }
  .brand:hover { text-decoration: none; }
  .brand__mark {
    display: inline-grid; place-items: center; width: 38px; height: 38px;
    background: var(--color-primary); color: #fff; border-radius: 8px; font-size: 0.9rem; letter-spacing: 0.5px;
  }
  .brand__name { font-size: 1.1rem; }
  .site-nav ul { display: flex; align-items: center; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .site-nav a { display: block; padding: 0.5rem 0.75rem; color: var(--color-fg); font-weight: 500; border-radius: 6px; }
  .site-nav a:hover { background: var(--color-surface); text-decoration: none; }
  .site-nav a.is-active { color: var(--color-primary); }

  /* Menú hamburguesa (mobile) */
  .nav-toggle, .nav-toggle__btn { display: none; }
  @media (max-width: 900px) {
    .nav-toggle__btn { display: inline-flex; flex-direction: column; gap: 5px; cursor: pointer; padding: 0.5rem; }
    .nav-toggle__btn span { width: 26px; height: 2px; background: var(--color-fg); display: block; }
    .site-nav {
      position: absolute; top: 100%; left: 0; right: 0;
      background: var(--color-bg); border-bottom: 1px solid var(--color-border);
      max-height: 0; overflow: hidden; transition: max-height 0.25s ease;
    }
    .site-nav ul { flex-direction: column; align-items: stretch; padding: 0.5rem 1.25rem 1rem; }
    .nav-toggle:checked ~ .site-nav { max-height: 80vh; }
  }
</style>
