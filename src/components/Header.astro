---
import { site, nav } from '../site.config';
import Logo from './Logo.astro';
import { withBase } from '../utils/url';
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isActive = (href: string) => {
  const full = base + href;
  return href === '/' ? path === base + '/' || path === base || path === '/' : path.startsWith(full);
};
---
<header class="site-header">
  <!-- Barra utilitaria -->
  <div class="topbar">
    <div class="container topbar__inner">
      <div class="topbar__contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span>
        <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </div>
      <div class="topbar__social">
        <a href={site.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.46-.03-3.34-2.03-3.34-2.03 0-2.34 1.59-2.34 3.23V21H9z"/></svg>
        </a>
        <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Barra principal -->
  <div class="mainbar">
    <div class="container mainbar__inner">
      <a href={withBase('/')} class="brand" aria-label={site.name}><Logo /></a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
      <label for="nav-toggle" class="nav-toggle__btn" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </label>

      <nav class="site-nav" aria-label="Menú principal">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} class={isActive(item.href) ? 'is-active' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 60; }
  .topbar { background: var(--navy-950); color: var(--color-on-dark-muted); font-size: 0.85rem; }
  .topbar__inner { display: flex; justify-content: space-between; align-items: center; min-height: 38px; gap: 1rem; }
  .topbar a { color: var(--color-on-dark-muted); }
  .topbar a:hover { color: #fff; text-decoration: none; }
  .topbar__contact { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .topbar__social { display: flex; gap: 0.75rem; align-items: center; }

  .mainbar { background: #fff; border-bottom: 1px solid var(--color-border); box-shadow: var(--shadow-sm); }
  .mainbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 74px; }
  .brand { display: inline-flex; align-items: center; }
  .brand:hover { text-decoration: none; }

  .site-nav ul { display: flex; align-items: center; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .site-nav a { display: block; padding: 0.5rem 0.7rem; color: var(--color-fg); font-weight: 600; font-size: 0.94rem; border-radius: 8px; }
  .site-nav a:hover { background: var(--color-surface); text-decoration: none; }
  .site-nav a.is-active { color: var(--color-accent-dark); }

  .nav-toggle, .nav-toggle__btn { display: none; }
  @media (max-width: 1024px) {
    .nav-toggle__btn { display: inline-flex; flex-direction: column; gap: 5px; cursor: pointer; padding: 0.5rem; }
    .nav-toggle__btn span { width: 26px; height: 2px; background: var(--color-primary); display: block; border-radius: 2px; }
    .site-nav {
      position: absolute; left: 0; right: 0; top: 100%;
      background: #fff; border-bottom: 1px solid var(--color-border);
      max-height: 0; overflow: hidden; transition: max-height 0.28s ease; box-shadow: var(--shadow);
    }
    .site-nav ul { flex-direction: column; align-items: stretch; padding: 0.5rem 1.5rem 1.25rem; gap: 0.1rem; }
    .site-nav a { padding: 0.7rem 0.5rem; border-bottom: 1px solid var(--color-surface-2); border-radius: 0; }
    .nav-toggle:checked ~ .site-nav { max-height: 85vh; }
  }
</style>
