---
import { site } from '../site.config';
import Logo from './Logo.astro';
import { servicios } from '../data/servicios';
import { withBase } from '../utils/url';
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isActive = (href: string) => {
  const full = base + href;
  return href === '/' ? path === base + '/' || path === '/' : path.startsWith(full);
};
const servicioActivo = servicios.some((s) => isActive(s.href));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href={withBase('/')} class="brand" aria-label={site.name}><Logo /></a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle__btn" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Menú principal">
      <ul>
        <li class="has-drop">
          <a href={withBase('/videovigilancia/')} class={servicioActivo ? 'is-active' : undefined}>
            Servicios y Productos
            <svg class="caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <ul class="drop">
            {servicios.map((s) => <li><a href={withBase(s.href)}>{s.titulo}</a></li>)}
            <li><a href={withBase('/camscope/')}>CamScope</a></li>
          </ul>
        </li>
        <li><a href={withBase('/sobre-nosotros/')} class={isActive('/sobre-nosotros/') ? 'is-active' : undefined}>Sobre Nosotros</a></li>
        <li><a href={withBase('/novedades/')} class={isActive('/novedades/') ? 'is-active' : undefined}>Novedades</a></li>
        <li><a href={withBase('/contacto/')} class={isActive('/contacto/') ? 'is-active' : undefined}>Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 60; background: #fff; border-bottom: 1px solid var(--border); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 66px; }
  .brand { display: inline-flex; align-items: center; }
  .brand:hover { text-decoration: none; }

  .site-nav > ul { display: flex; align-items: center; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .site-nav a { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.5rem 0.85rem; color: var(--fg); font-weight: 400; font-size: 0.9rem; border-radius: 8px; }
  .site-nav a:hover { color: var(--teal); text-decoration: none; }
  .site-nav a.is-active { color: var(--teal); }
  .caret { opacity: 0.7; }

  /* Dropdown */
  .has-drop { position: relative; }
  .drop {
    position: absolute; top: 100%; left: 0; min-width: 250px;
    background: #fff; border: 1px solid var(--border); border-radius: 12px;
    box-shadow: var(--shadow); padding: 0.5rem; margin: 0; list-style: none;
    opacity: 0; visibility: hidden; transform: translateY(8px); transition: all 0.18s ease;
  }
  .has-drop:hover .drop, .has-drop:focus-within .drop { opacity: 1; visibility: visible; transform: translateY(0); }
  .drop a { display: block; padding: 0.6rem 0.9rem; border-radius: 8px; font-size: 0.96rem; }
  .drop a:hover { background: var(--teal-tint); color: var(--teal); }

  /* Mobile */
  .nav-toggle, .nav-toggle__btn { display: none; }
  @media (max-width: 1000px) {
    .nav-toggle__btn { display: inline-flex; flex-direction: column; gap: 5px; cursor: pointer; padding: 0.5rem; }
    .nav-toggle__btn span { width: 26px; height: 2px; background: var(--teal); display: block; border-radius: 2px; }
    .site-nav { position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-bottom: 1px solid var(--border); max-height: 0; overflow: hidden; transition: max-height 0.28s ease; box-shadow: var(--shadow); }
    .site-nav > ul { flex-direction: column; align-items: stretch; padding: 0.75rem 1.5rem 1.25rem; gap: 0.1rem; }
    .site-nav a { padding: 0.8rem 0.5rem; }
    .drop { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: none; padding: 0 0 0 1rem; min-width: 0; }
    .nav-toggle:checked ~ .site-nav { max-height: 90vh; }
  }
</style>
