---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { servicios, industrias, partners } from '../data/servicios';
import { withBase } from '../utils/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">Building Networks · Córdoba, Argentina</p>
      <h1>Enfocate en lo tuyo,<br />nosotros te respaldamos</h1>
      <p class="hero__lead">
        Soluciones tecnológicas integrales que garantizan respaldo, seguridad y
        escalabilidad a grandes organizaciones.
      </p>
      <div class="hero__cta">
        <a class="btn" href={withBase("/contacto/")}>Contactanos <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href={withBase("/sobre-nosotros/")}>Sobre nosotros</a>
      </div>
      <ul class="partners" aria-label="Partners">
        {partners.map((p) => (
          <li><strong>{p.nombre}</strong><span>{p.detalle}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- NOTICIA DESTACADA -->
  <section class="section section--surface">
    <div class="container feature">
      <div class="feature__media" aria-hidden="true"><Icon name="camera" size={54} /></div>
      <div>
        <p class="eyebrow">Noticia</p>
        <h2>AXIS destaca el despliegue de Building Networks en el Distrito Capitalinas</h2>
        <p class="lead">
          El líder mundial en cámaras y audio IP publicó en su sección «Historias de Clientes»
          el proyecto Distrito Capitalinas, donde se incorporaron más de 400 cámaras IP y más de
          70 altavoces IP.
        </p>
        <a class="card__more" href={withBase("/novedades/")}>Ver novedades <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section">
    <div class="container">
      <p class="eyebrow center">Redes convergentes, soluciones integrales</p>
      <h2 class="center">Diseñamos y construimos redes donde vive toda tu organización</h2>
      <p class="lead center measure mx-auto">
        Sistemas y procesos, videovigilancia, control de accesos, cómputo y conectividad.
        Todo como un mismo sistema, seguro y escalable.
      </p>
      <div class="grid grid--3" style="margin-top:2.5rem">
        {servicios.map((s) => (
          <a class="card card--link" href={withBase(s.href)}>
            <span class="card__icon"><Icon name={s.icono} /></span>
            <h3>{s.titulo}</h3>
            <p>{s.resumen}</p>
            <span class="card__more">Ver más <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CAMSCOPE -->
  <section class="section section--dark">
    <div class="container feature feature--reverse">
      <div>
        <p class="eyebrow">Software de desarrollo propio</p>
        <h2>CamScope</h2>
        <p class="lead">
          Nuestro software nuclea los sistemas de Video Vigilancia, Audio IP y Control de Accesos.
          Centraliza la gestión de cámaras, parlantes y accesos en grandes organizaciones, de
          manera simple e intuitiva.
        </p>
        <a class="btn btn--light" href={withBase("/camscope/")}>Conocer CamScope <Icon name="arrow" size={18} /></a>
      </div>
      <div class="feature__media feature__media--dark" aria-hidden="true"><Icon name="server" size={54} /></div>
    </div>
  </section>

  <!-- INDUSTRIAS -->
  <section class="section section--surface">
    <div class="container">
      <p class="eyebrow center">Trabajamos con todas las industrias</p>
      <h2 class="center">Soluciones a la medida de cada sector</h2>
      <div class="grid grid--3" style="margin-top:2.5rem">
        {industrias.map((i) => (
          <div class="card">
            <span class="card__icon"><Icon name="shield" /></span>
            <h3>{i.titulo}</h3>
            <p>{i.resumen}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DATA CENTER CAPITALINAS -->
  <section class="section">
    <div class="container feature">
      <div class="feature__media" aria-hidden="true"><Icon name="server" size={54} /></div>
      <div>
        <p class="eyebrow">Unidad de negocio</p>
        <h2>Datacenter Capitalinas</h2>
        <p class="lead">
          Infraestructura robusta y servicios avanzados de almacenamiento, conectividad y
          seguridad digital, diseñados para operaciones críticas con máxima eficiencia y escalabilidad.
        </p>
        <ul class="checks">
          <li><Icon name="check" size={18} /> Alojamiento / Housing</li>
          <li><Icon name="check" size={18} /> Entorno controlado</li>
          <li><Icon name="check" size={18} /> Seguridad</li>
          <li><Icon name="check" size={18} /> Energía ininterrumpida</li>
        </ul>
        <a class="card__more" href={withBase("/data-center/")}>Ver Data Center <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- CASO DE ÉXITO -->
  <section class="section section--dark">
    <div class="container center measure mx-auto">
      <p class="eyebrow">Caso de éxito</p>
      <h2>Distrito Capitalinas · Córdoba</h2>
      <p class="lead">
        Desarrollamos redes sobre las que desplegamos sistemas que ven, escuchan, hablan y piensan.
        Descargá el informe completo con todos los detalles de este caso emblemático en el distrito
        corporativo más importante de la ciudad.
      </p>
      <a class="btn" href={withBase("/contacto/")}>Descargar informe <Icon name="download" size={18} /></a>
    </div>
  </section>

  <!-- ÚLTIMAS NOVEDADES -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow center">Últimas novedades</p>
        <h2 class="center">Novedades y noticias</h2>
        <div class="grid grid--3" style="margin-top:2.5rem">
          {posts.map((post) => (
            <a class="card card--link" href={withBase(`/novedades/${post.id}/`)}>
              <p class="card__date">{fmt(post.data.pubDate)}</p>
              <h3>{post.data.title}</h3>
              {post.data.description && <p>{post.data.description}</p>}
              <span class="card__more">Leer más <Icon name="arrow" size={16} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA ASESOR -->
  <section class="section--tight cta">
    <div class="container cta__inner">
      <div>
        <h2>Agendá una reunión con un asesor comercial</h2>
        <p class="lead">¿Te gustaría entender si podemos ayudarte? Coordinemos una reunión con un especialista.</p>
      </div>
      <a class="btn btn--light" href={withBase("/contacto/")}>Coordinar reunión <Icon name="calendar" size={18} /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: radial-gradient(1200px 600px at 80% -10%, var(--navy-600), transparent 60%), linear-gradient(160deg, var(--navy-950), var(--navy-800)); color: var(--color-on-dark); }
  .hero__inner { padding-block: clamp(3.5rem, 9vw, 7rem); max-width: 820px; }
  .hero h1 { color: #fff; }
  .hero__lead { font-size: 1.3rem; color: var(--color-on-dark-muted); max-width: 620px; }
  .hero__cta { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .partners { display: flex; flex-wrap: wrap; gap: 2rem; list-style: none; padding: 0; margin: 3rem 0 0; border-top: 1px solid rgba(255,255,255,0.12); padding-top: 1.5rem; }
  .partners li { display: flex; flex-direction: column; line-height: 1.2; }
  .partners strong { color: #fff; font-size: 1.15rem; letter-spacing: 0.05em; }
  .partners span { color: var(--color-on-dark-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; }

  .feature { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3rem; align-items: center; }
  .feature--reverse .feature__media { order: 2; }
  .feature__media { background: linear-gradient(150deg, var(--color-surface-2), #fff); border: 1px solid var(--color-border); border-radius: var(--radius-lg); min-height: 260px; display: grid; place-items: center; color: var(--color-accent-dark); }
  .feature__media--dark { background: linear-gradient(150deg, var(--navy-800), var(--navy-950)); border-color: rgba(255,255,255,0.1); color: var(--color-accent); }
  .checks { list-style: none; padding: 0; margin: 1.25rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem; }
  .checks li { display: flex; align-items: center; gap: 0.5rem; font-weight: 500; }
  .section--dark .checks li { color: var(--color-on-dark); }
  .checks svg { color: var(--color-accent); flex: none; }
  .card__date { color: var(--color-accent-dark); font-size: 0.85rem; font-weight: 600; margin: 0 0 0.35rem; text-transform: capitalize; }

  .cta { background: var(--color-accent); color: #fff; }
  .cta__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; padding-block: 2.5rem; }
  .cta h2 { color: #fff; margin-bottom: 0.25rem; }
  .cta .lead { color: rgba(255,255,255,0.9); margin: 0; }

  @media (max-width: 820px) {
    .feature { grid-template-columns: 1fr; gap: 1.75rem; }
    .feature--reverse .feature__media { order: 0; }
    .checks { grid-template-columns: 1fr; }
  }
</style>
