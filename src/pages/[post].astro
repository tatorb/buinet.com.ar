---
import { withBase } from '../utils/url';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Los artículos del blog se sirven en la RAÍZ (/slug/), igual que en el
// WordPress original, para preservar las URLs indexadas y los backlinks.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { post: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' });
const heroStyle = post.data.heroImage
  ? `background: linear-gradient(160deg, rgba(0,70,75,0.86), rgba(0,98,105,0.66)), url("${post.data.heroImage}") center/cover no-repeat;`
  : undefined;
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <section class="svc-hero" style={heroStyle}>
    <div class="container" style="padding-block:clamp(1.9rem,4.2vw,3.1rem); max-width:820px">
      <p class="eyebrow">Novedades</p>
      <h1 style="color:#fff">{post.data.title}</h1>
      <p class="post__meta">
        {fmt(post.data.pubDate)}{post.data.category ? ` · ${post.data.category}` : ''}{post.data.author ? ` · ${post.data.author}` : ''}
      </p>
    </div>
  </section>

  <article class="section">
    <div class="container post__inner prose">
      <Content />
      <p class="post__back"><a href={withBase("/novedades/")}><Icon name="arrow" size={16} /> Volver a Novedades</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .svc-hero { background: linear-gradient(160deg, rgba(0,70,75,0.86), rgba(0,98,105,0.66)), url("/wp-content/uploads/2024/12/PORTADA-SOLUCION-INTEGRAL-CONVERGENTE-100.jpg") center/cover no-repeat; }
  .post__meta { color: var(--color-on-dark-muted); font-size: 0.95rem; text-transform: capitalize; margin: 0; }
  .post__inner { max-width: 720px; }
  .prose :global(h2) { margin-top: 2rem; }
  .prose :global(img) { border-radius: var(--radius); margin-block: 1.5rem; }
  .prose :global(pre) { background: var(--color-surface); padding: 1rem; border-radius: 8px; overflow-x: auto; }
  /* Tablas comparativas: scrollean solas en pantallas angostas. */
  .prose :global(table) { width: 100%; border-collapse: collapse; margin-block: 1.75rem; font-size: 0.94rem; display: block; overflow-x: auto; }
  .prose :global(thead th) { background: var(--teal-tint); color: var(--heading); font-weight: 600; text-align: left; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--border); padding: 0.7rem 0.9rem; vertical-align: top; }
  .prose :global(tbody tr:nth-child(even)) { background: var(--surface); }
  .prose :global(tbody td:first-child) { font-weight: 500; color: var(--heading); }
  .post__back { margin-top: 2.5rem; }
  .post__back a { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; }
</style>
