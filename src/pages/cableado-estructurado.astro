<script>
  // Las frases de alcance entran de a una al acercarse al viewport.
  // Si el visitante pidió menos movimiento, se muestran todas y no se observa
  // nada: la animación no puede ser la condición para leer el contenido.
  const items = Array.from(document.querySelectorAll<HTMLElement>('#ce-incluye .ce-incluye__it'));
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (quieto || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entradas, obs) => {
        // Las que entran juntas en el mismo cuadro se escalonan, así se leen
        // de a una en vez de aparecer todas de golpe.
        entradas
          .filter((e) => e.isIntersecting)
          .forEach((e, i) => {
            const el = e.target as HTMLElement;
            setTimeout(() => el.classList.add('is-in'), i * 110);
            obs.unobserve(el);
          });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    items.forEach((el) => io.observe(el));
  }
</script>
