  .chk input { accent-color: var(--teal); width: 16px; height: 16px; flex: none; }
  .tienda__limpiar { justify-self: start; font-size: 0.85rem; padding: 0.45rem 0.9rem; }

  .tienda__barra { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.3rem; }
  .tienda__conteo { margin: 0; color: var(--muted); font-size: 0.92rem; }
