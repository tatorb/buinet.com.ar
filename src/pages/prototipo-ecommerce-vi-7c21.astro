  /* Grilla de 12 columnas. El filtro toma 3 y los productos los 9 restantes.
     Las dos grillas comparten el mismo --gap a propósito: con 9 columnas
     dentro de un área de 9 columnas y el mismo gap, las pistas internas miden
     exactamente lo mismo que las del padre, así que las tarjetas caen sobre
     la misma retícula de 12. Si los gaps difieren, se desalinea. */
  .tienda { --gap: 1.4rem; }
  .tienda__layout { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--gap); margin-top: 2.6rem; align-items: start; }
  /* align-self: stretch es lo que hace funcionar el sticky de adentro. El
     padre tiene align-items: start, asi que sin esto la columna mide lo mismo
     que su contenido (538px contra 5591px de la grilla de productos) y el
     elemento pegajoso no tiene recorrido: se va con el scroll. */
  .tienda__filtros { grid-column: span 3; padding-right: 0.8rem; align-self: stretch; }
  .tienda__main { grid-column: span 9; }
  .tienda__filtros-inner { position: sticky; top: 90px; display: grid; gap: 1.5rem; }
  .filtro { border: 0; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
