  .tienda__orden select { padding: 0.45rem 0.6rem; border: 1px solid var(--border); border-radius: 8px; font: inherit; font-size: 0.9rem; background: #fff; }

  .tienda__grid { display: grid; grid-template-columns: repeat(9, 1fr); gap: var(--gap); }
