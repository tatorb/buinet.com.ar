  .carrito__items :global(.ci__precio) { margin: 0; font-size: 0.95rem; white-space: nowrap; align-self: center; }
  .carrito__items :global(.ci__fila) { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin-top: 0.35rem; }
  .carrito__items :global(.ci__quitar) { background: 0; border: 0; color: var(--muted); font-size: 0.83rem; text-decoration: underline; cursor: pointer; padding: 0; }
  .carrito__items :global(.ci__quitar:hover) { color: #a3271f; }
  /* El selector de cantidad también se inyecta, así que se repite en global. */
  .carrito__items :global(.qty) { display: flex; align-items: center; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; flex: none; }
  .carrito__items :global(.qty__b) { width: 30px; height: 34px; border: 0; background: var(--surface); color: var(--heading); font-size: 1rem; cursor: pointer; line-height: 1; }
  .carrito__items :global(.qty__b:hover) { background: var(--teal-tint-2); }
  .carrito__items :global(.qty__i) { width: 46px; height: 34px; border: 0; border-inline: 1px solid var(--border); text-align: center; font: inherit; font-size: 0.92rem; -moz-appearance: textfield; }
  .carrito__items :global(.qty__i::-webkit-outer-spin-button), .carrito__items :global(.qty__i::-webkit-inner-spin-button) { -webkit-appearance: none; margin: 0; }
  .carrito__pie { border-top: 1px solid var(--border); padding: 1.1rem 1.3rem 1.4rem; display: grid; gap: 0.7rem; }
  .carrito__total { display: flex; align-items: baseline; justify-content: space-between; font-size: 1.05rem; }
  .carrito__total strong { font-size: 1.35rem; font-weight: 500; color: var(--heading); }
  .carrito__aclara { margin: 0; font-size: 0.8rem; color: var(--muted); }
  .carrito__cta, .carrito__cta2 { width: 100%; text-align: center; }
  .carrito__cta2 { font-size: 0.68rem; border-color: var(--border); color: var(--muted); }
  .carrito__cta2:hover { border-color: var(--teal); background: transparent; color: var(--teal); }

  /* Sin lugar para la columna de filtros: los dos bloques pasan a ancho
     completo de las 12 y las tarjetas bajan a dos por fila, y despues a una. */
  @media (max-width: 980px) {
    .tienda__filtros, .tienda__main { grid-column: 1 / -1; }
    .tienda__filtros { padding-right: 0; }
    .tienda__filtros-inner { position: static; grid-template-columns: repeat(2, 1fr); }
    .tienda__grid { grid-template-columns: repeat(2, 1fr); }
    .prod { grid-column: auto; }
  }
  @media (max-width: 620px) {
    .tienda__filtros-inner { grid-template-columns: 1fr; }
    .tienda__grid { grid-template-columns: 1fr; }
    .carrito { width: 100vw; }
  }

</style>

<script>
  // Prototipo: filtros + carrito, todo en el navegador. Sin backend.
  // El carrito se guarda en localStorage para que sobreviva a un refresh;
  // toda lectura y escritura va envuelta porque en modo privado puede tirar.
  const money = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });
  const $ = (s: string) => document.querySelector(s);
  const CLAVE = 'proto-carrito-vi';

  // ---------------------------------------------------------------- precios
  document.querySelectorAll<HTMLElement>('[data-precio-txt]').forEach((el) => {
    el.textContent = money.format(Number(el.dataset.precioTxt));
  });

  // ---------------------------------------------------------------- filtros
  const fichas = Array.from(document.querySelectorAll<HTMLElement>('.prod'));
  const buscar = $('#f-buscar') as HTMLInputElement;
  const orden = $('#f-orden') as HTMLSelectElement;
  const rango = $('#f-precio') as HTMLInputElement;
  const rangoOut = $('#f-precio-out') as HTMLOutputElement;
  const conteo = $('#conteo') as HTMLElement;
  const vacio = $('#vacio') as HTMLElement;
  const grid = $('#grid') as HTMLElement;

  const marcados = (k: string) =>
    Array.from(document.querySelectorAll<HTMLInputElement>(`[data-filtro="${k}"]:checked`)).map((i) => i.value);

  function aplicar() {
    const q = buscar.value.trim().toLowerCase();
    const cats = marcados('categoria');
    const ents = marcados('entorno');
    const soloAnalitica = marcados('analitica').length > 0;
    const tope = Number(rango.value);
    rangoOut.textContent = money.format(tope);

    let visibles = 0;
    for (const f of fichas) {
      const d = f.dataset;
      const ok =
        (!q || (d.busca || '').includes(q)) &&
        (!cats.length || cats.includes(d.categoria!)) &&
        // "ambos" entra en cualquier filtro de entorno
        (!ents.length || d.entorno === 'ambos' || ents.includes(d.entorno!)) &&
        (!soloAnalitica || d.analitica === 'si') &&
        Number(d.precio) <= tope;
      f.hidden = !ok;
      if (ok) visibles++;
    }
    conteo.textContent = visibles === fichas.length
      ? `${fichas.length} equipos`
      : `${visibles} de ${fichas.length} equipos`;
    vacio.hidden = visibles > 0;
    ordenar();
  }

  function ordenar() {
    const modo = orden.value;
    if (modo === 'relevancia') return;
    const cmp: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      'precio-asc': (a, b) => Number(a.dataset.precio) - Number(b.dataset.precio),
      'precio-desc': (a, b) => Number(b.dataset.precio) - Number(a.dataset.precio),
      nombre: (a, b) => (a.dataset.nombre || '').localeCompare(b.dataset.nombre || '', 'es'),
    };
    [...fichas].sort(cmp[modo]).forEach((f) => grid.appendChild(f));
  }

  function limpiar() {
    buscar.value = '';
    document.querySelectorAll<HTMLInputElement>('[data-filtro]').forEach((i) => (i.checked = false));
    rango.value = rango.max;
    orden.value = 'relevancia';
    fichas.sort((a, b) => fichas.indexOf(a) - fichas.indexOf(b));
    aplicar();
  }

  buscar.addEventListener('input', aplicar);
  rango.addEventListener('input', aplicar);
  orden.addEventListener('change', aplicar);
  document.querySelectorAll('[data-filtro]').forEach((i) => i.addEventListener('change', aplicar));
  $('#f-limpiar')!.addEventListener('click', limpiar);
  $('#vacio-limpiar')!.addEventListener('click', limpiar);

  // --------------------------------------------------------------- cantidad
  document.querySelectorAll<HTMLButtonElement>('.qty__b').forEach((b) => {
    b.addEventListener('click', () => {
      const input = b.parentElement!.querySelector('.qty__i') as HTMLInputElement;
      const v = Math.max(1, Math.min(999, Number(input.value) + Number(b.dataset.paso)));
      input.value = String(v);
    });
  });

  // ---------------------------------------------------------------- carrito
  type Linea = { sku: string; nombre: string; modelo: string; precio: number; cant: number };
  let carrito: Linea[] = [];
  try {
    carrito = JSON.parse(localStorage.getItem(CLAVE) || '[]');
  } catch { carrito = []; }

  const guardar = () => { try { localStorage.setItem(CLAVE, JSON.stringify(carrito)); } catch {} };

  const panel = $('#carrito') as HTMLElement;
  const velo = $('#carrito-velo') as HTMLElement;
  const items = $('#carrito-items') as HTMLElement;

  function pintar() {
    const n = carrito.reduce((s, l) => s + l.cant, 0);
    ($('#carrito-n') as HTMLElement).textContent = String(n);
    ($('#carrito-total') as HTMLElement).textContent = money.format(
      carrito.reduce((s, l) => s + l.precio * l.cant, 0),
    );
    if (!carrito.length) {
      items.innerHTML = '<p class="carrito__vacio">Todavía no agregaste equipos.</p>';
      return;
    }
    items.innerHTML = carrito
      .map(
        (l) => `<div class="ci" data-sku="${l.sku}">
          <div><p class="ci__modelo">${l.modelo}</p><p class="ci__nombre">${l.nombre}</p></div>
          <p class="ci__precio">${money.format(l.precio * l.cant)}</p>
          <div class="ci__fila">
            <div class="qty">
              <button type="button" class="qty__b ci__paso" data-paso="-1" aria-label="Quitar uno">−</button>
              <input class="qty__i ci__cant" type="number" value="${l.cant}" min="1" max="999" aria-label="Cantidad">
              <button type="button" class="qty__b ci__paso" data-paso="1" aria-label="Sumar uno">+</button>
            </div>
            <button type="button" class="ci__quitar">Quitar</button>
          </div>
        </div>`,
      )
      .join('');
  }

  function agregar(sku: string, cant: number) {
    const f = fichas.find((x) => x.dataset.sku === sku)!;
    const linea = carrito.find((l) => l.sku === sku);
    if (linea) linea.cant = Math.min(999, linea.cant + cant);
    else
      carrito.push({
        sku,
        nombre: f.dataset.nombre!,
        modelo: (f.querySelector('.prod__modelo') as HTMLElement).textContent!.trim(),
        precio: Number(f.dataset.precio),
        cant,
      });
    guardar();
    pintar();
  }

  document.querySelectorAll<HTMLButtonElement>('.prod__add').forEach((b) => {
    b.addEventListener('click', () => {
      const ficha = b.closest('.prod') as HTMLElement;
      const cant = Number((ficha.querySelector('.qty__i') as HTMLInputElement).value) || 1;
      agregar(ficha.dataset.sku!, cant);
      const txt = b.textContent;
      b.textContent = 'Agregado ✓';
      b.disabled = true;
      setTimeout(() => { b.textContent = txt; b.disabled = false; }, 900);
    });
  });

  items.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const fila = t.closest('.ci') as HTMLElement;
    if (!fila) return;
    const linea = carrito.find((l) => l.sku === fila.dataset.sku)!;
    if (t.classList.contains('ci__quitar')) carrito = carrito.filter((l) => l !== linea);
    else if (t.classList.contains('ci__paso')) {
      linea.cant += Number(t.dataset.paso);
      if (linea.cant < 1) carrito = carrito.filter((l) => l !== linea);
    } else return;
    guardar();
    pintar();
  });

  items.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (!t.classList.contains('ci__cant')) return;
    const fila = t.closest('.ci') as HTMLElement;
    const linea = carrito.find((l) => l.sku === fila.dataset.sku)!;
    linea.cant = Math.max(1, Math.min(999, Number((t as HTMLInputElement).value) || 1));
    guardar();
    pintar();
  });

  const abrir = (v: boolean) => {
    panel.hidden = !v;
    velo.hidden = !v;
    document.body.style.overflow = v ? 'hidden' : '';
    if (v) ($('#carrito-cerrar') as HTMLElement).focus();
  };
  $('#carrito-abrir')!.addEventListener('click', () => abrir(true));
  $('#carrito-cerrar')!.addEventListener('click', () => abrir(false));
  velo.addEventListener('click', () => abrir(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) abrir(false); });

  pintar();
  aplicar();
</script>
