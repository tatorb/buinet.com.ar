---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import YouTube from '../components/YouTube.astro';
import { withBase } from '../utils/url';
import { productos, CATEGORIAS, ENTORNOS } from '../data/catalogo-axis';

// ============================================================================
// PROTOTIPO — NO ES UNA PÁGINA PÚBLICA.
//
// Copia de /video-inteligente/ con una sección de e-commerce agregada, para
// ver cómo conviven el argumento de servicio y una grilla de producto en la
// misma página.
//
// Cómo queda oculta, tres candados:
//  1. URL con token difícil de adivinar (el sufijo -7c21).
//  2. noindex en el <head> (prop noindex de BaseLayout).
//  3. Excluida del sitemap, en el filter de astro.config.mjs.
// No está enlazada desde ningún lado: ni el menú, ni el pie, ni otra página.
//
// No tiene backend. El carrito vive en el navegador (localStorage) y los
// botones de compra no hacen nada: son para mirar el flujo, no para operar.
// El catálogo y los precios son de mentira, ver src/data/catalogo-axis.ts.
// ============================================================================

const precioMax = Math.max(...productos.map((p) => p.precio));

// ============================================================================
// PÁGINA DE SERVICIO — Video inteligente.
// Nivel /videovigilancia/ e /infraestructura-de-red/: usa BaseLayout directo,
// no ServiceLayout, porque tiene estructura propia.
// Poco texto arriba, todo el desarrollo en las FAQ.
// ============================================================================

const beneficios = [
  'Detecta condiciones antes de que se conviertan en incidente',
  'Genera datos de proceso en tiempo real, no solo grabaciones',
  'Responde automáticamente integrado con audio IP',
  'Se gestiona junto con la red, accesos y audio desde CamScope',
];

const sectores = [
  { titulo: 'Industria y manufactura', resumen: 'Líneas, perímetros, EPP, auditoría de proceso', icono: 'factory' },
  { titulo: 'Logística y distribución', resumen: 'LPR, trazabilidad, tiempos de ciclo', icono: 'network' },
  { titulo: 'Corporativo y oficinas', resumen: 'Accesos, visitas, perímetro de edificio', icono: 'building' },
  { titulo: 'Industria regulada', resumen: 'Alimentaria, farmacéutica, salud', icono: 'shield' },
];

const diferenciales = [
  { titulo: 'AXIS Solution Gold Partner', resumen: 'Hardware con LTS documentado y ciberseguridad desde el diseño', icono: 'camera' },
  { titulo: 'CamScope', resumen: 'Plataforma propia, sin licenciamiento por canal', icono: 'server' },
  { titulo: 'Casi veinte años en Córdoba', resumen: 'Industria, logística, corporativo y sector regulado', icono: 'lock' },
];

// Enunciado de oferta congelado. Va textual, sin variantes ni sinónimos.
const OFERTA =
  'Sistemas de video para la detección, el control y la seguridad mediante IA, analítica y metadatos integrados en los dispositivos y en tiempo real.';

// Los tres bloques de desarrollo pasan a cards con un resumen breve. El texto
// completo no se pierde: vive íntegro en las FAQ de más abajo, que es donde lo
// leen tanto las personas como los modelos de lenguaje.
const pilares = [
  {
    titulo: 'Cómo funciona',
    icono: 'chip',
    resumen: 'El procesamiento ocurre en el propio dispositivo, no en un servidor central. Cada cámara clasifica lo que ve en el momento, y eso libera ancho de banda, escalabilidad y disponibilidad.',
  },
  {
    titulo: 'El dato',
    icono: 'database',
    resumen: 'Cada hecho genera un metadato, la descripción de lo que pasó separada de la imagen. Pesa una fracción del video, se consulta como una base de datos y se integra con los sistemas que ya usás.',
  },
  {
    titulo: 'Detección, control y seguridad',
    icono: 'target',
    resumen: 'Detectar es clasificar antes de alertar. Controlar es que el evento dispare una acción en otro sistema. Asegurar es que ese registro sirva como evidencia y sostenga el cumplimiento.',
  },
];

// Cifras del caso. Son las únicas ocho autorizadas. No sumar ninguna más.

// El complejo no se nombra por pedido expreso del cliente.
const cifras = [
  { valor: '436', label: 'cámaras' },
  { valor: '8', label: 'servidores dedicados' },
  { valor: '88', label: 'controladores de acceso' },
  { valor: '264', label: 'puntos de acceso controlados' },
  { valor: '64', label: 'dispositivos de audio IP' },
  { valor: '42', label: 'switches' },
  { valor: '1.176', label: 'puertos activos' },
  { valor: '+15 años', label: 'de operación continua' },
];

// Satélites del cluster. Los textos de enlace describen el escenario, nunca el
// producto, y ninguno contiene el término vedado.
const escenarios = [
  {
    titulo: 'Lectura de patentes y acceso vehicular',
    resumen: 'Cuando lo que hay que resolver es quién entra y sale en portería, sin detener la circulación.',
    icono: 'car',
    href: '/lpr-control-acceso-vehicular/',
  },
  {
    titulo: 'NVR o VMS, cómo elegir la base del sistema',
    resumen: 'La decisión que condiciona todo lo que se pueda hacer después.',
    icono: 'server',
    href: '/nvr-vs-vms/',
  },
  {
    titulo: 'Almacenamiento y retención',
    resumen: 'Cuánto tiempo hay que poder mirar hacia atrás, y qué cuesta sostenerlo.',
    icono: 'database',
    href: '/almacenamiento-videovigilancia/',
  },
  {
    titulo: 'Ciclo de vida del parque de dispositivos',
    resumen: 'Cuándo un dispositivo dejó de rendir y conviene reemplazarlo.',
    icono: 'clock',
    href: '/vida-util-camara-ip/',
  },
  {
    titulo: 'Merma y faltante interno',
    resumen: 'Cuando la pérdida ocurre adentro y no hay un ingreso forzado que investigar.',
    icono: 'box',
    href: '/merma-robo-interno-videovigilancia/',
  },
  {
    titulo: 'Auditoría de procesos',
    resumen: 'Usar el registro para verificar cómo se trabaja, no solamente para investigar un hecho.',
    icono: 'clipboard',
    href: '/auditoria-procesos-video/',
  },
  {
    titulo: 'Integración con accesos y audio IP',
    resumen: 'Que la detección dispare una acción y no solamente un aviso.',
    icono: 'speaker',
    href: '/integracion-control-accesos-audio-ip/',
  },
  {
    titulo: 'Perímetros industriales',
    resumen: 'Grandes superficies donde el recorrido humano llega tarde.',
    icono: 'factory',
    href: '/videovigilancia-industrial/',
  },
  {
    titulo: 'Plantas de alimentos',
    resumen: 'Ambientes de lavado a presión, frío y trazabilidad por lote.',
    icono: 'food',
    href: '/videovigilancia-industria-alimenticia/',
  },
  {
    titulo: 'Obras en ejecución',
    resumen: 'Sistemas temporales que cambian a medida que avanza la obra.',
    icono: 'helmet',
    href: '/videovigilancia-en-obra/',
  },
  {
    titulo: 'Migración de sistemas analógicos a IP',
    resumen: 'Pasar a IP sin cortar la operación durante la transición.',
    icono: 'refresh',
    href: '/actualizacion-videovigilancia-analogica-a-ip/',
  },
  {
    titulo: 'Detección térmica',
    resumen: 'Zonas sin luz, humo o niebla, donde la imagen convencional no alcanza.',
    icono: 'thermometer',
    href: '/camaras-termicas-axis-para-industrias-y-perimetros/',
  },
];

// Las 12 FAQ alimentan el acordeón visible y el schema FAQPage. Un solo origen
// para las dos cosas, así nunca se desincronizan.
const faqs = [
  {
    q: '¿Cómo funciona la analítica de video embebida en el dispositivo?',
    a: 'El procesamiento ocurre dentro del propio dispositivo, no en un servidor central que recibe todo el video y después lo analiza. Cada dispositivo clasifica lo que ve en el momento en que lo ve. Eso cambia tres cosas de la operación. El ancho de banda deja de ser el límite del sistema, porque por la red viaja el evento y no la totalidad del video en crudo. La escalabilidad deja de depender de cuántos servidores se agreguen, porque cada dispositivo que se suma trae su propia capacidad de análisis. Y la disponibilidad mejora, porque un corte de enlace no interrumpe la clasificación, que sigue ocurriendo donde está el dispositivo. Cada imagen deja de ser un cuadro de video y pasa a ser un evento con datos asociados. Qué objeto, de qué tipo, en qué zona, a qué hora, con qué recorrido. Esos eventos quedan indexados, y un sistema indexado se busca, se integra y se audita. El tiempo de búsqueda de un hecho puntual deja de ser una revisión de horas de grabación y pasa a ser una consulta.',
  },
  {
    q: '¿Qué es un metadato de escena y para qué sirve?',
    a: 'Un metadato es la descripción de lo que pasó, separada de la imagen que lo muestra. Cuando un vehículo entra a un playón, el dispositivo no guarda solamente el video. Guarda además una ficha de ese hecho. Un objeto del tipo vehículo, que ingresó por una zona determinada, con la hora exacta de ingreso y el tiempo que permaneció. Esa ficha pesa una fracción mínima de lo que pesa el video, y a diferencia del video, se consulta como se consulta cualquier base de datos. La consecuencia práctica es que el video deja de terminar en una pantalla que alguien mira. Pasa a alimentar los sistemas que la organización ya usa para decidir. Los metadatos de escena responden a un formato estándar de la industria y no a un lenguaje cerrado de un fabricante. Por eso se integran con plataformas de gestión, con sistemas de control de acceso y con sistemas de negocio sin desarrollos a medida, y por eso la organización no queda atada a un proveedor único.',
  },
  {
    q: '¿Qué significan exactamente detección, control y seguridad?',
    a: 'Detección. El sistema distingue de qué tipo de objeto se trata antes de generar un evento. Una persona, un vehículo, algo que quedó detenido donde no corresponde. Esa clasificación es lo que separa un evento real de un falso positivo. Sobre esa base se calibran las reglas. Qué zona, qué umbral de permanencia, qué franja horaria, qué dirección de recorrido. Una regla mal calibrada produce tantos eventos que el operador deja de mirarlos, y un sistema que nadie mira no detecta nada. La calibración no es un ajuste inicial, es un trabajo que sigue durante toda la vida del sistema, porque la operación cambia. Control. La misma detección que dispara un evento puede disparar una acción en otro sistema. Un vehículo cuya patente está habilitada abre la barrera sin intervención de nadie. Un ingreso fuera de la franja permitida activa un mensaje por audio en el punto exacto donde está ocurriendo. El tiempo de respuesta deja de depender de que alguien esté mirando una pantalla en ese momento. Cuando la detección, el control de acceso y el audio comparten una sola línea de tiempo, aparece la trazabilidad. Cada hecho queda asociado a quién lo produjo, en qué punto, con qué credencial y con qué respuesta del sistema. Es la diferencia entre saber que algo pasó y poder reconstruir la secuencia completa. Seguridad. Un evento indexado es evidencia recuperable. Ante un reclamo, un siniestro o una investigación interna, el tiempo de búsqueda deja de medirse en jornadas de revisión, y la organización llega con material acotado al hecho y no con horas de grabación sin ordenar. El cumplimiento se apoya en lo mismo. Retención definida por política y no por lo que entra en el disco, acceso a la evidencia registrado y auditable, y zonas excluidas del análisis por decisión explícita. Un sistema que no puede demostrar quién vio qué y cuándo es un problema, no una defensa.',
  },
  {
    q: '¿Cuál es la diferencia entre un sistema que graba y uno que detecta?',
    a: 'Un sistema que graba almacena lo que la cámara ve para revisarlo después. Un sistema que detecta clasifica lo que ve en tiempo real y genera un evento cuando identifica una condición definida. La diferencia práctica es cuándo llega la información. Con grabación, la información llega cuando alguien la busca. Con detección, llega en el momento en que todavía se puede actuar.',
  },
  {
    q: '¿Qué puede detectar la analítica embebida en el dispositivo?',
    a: 'Depende de la configuración, pero las capacidades más comunes incluyen clasificación de objetos, personas, vehículos o animales, presencia en zonas definidas, cruce de líneas virtuales en una dirección específica, ausencia de EPP en zonas de riesgo, comportamientos de riesgo como caídas o corridas, permanencia excesiva en un sector, y variables térmicas cuando se usan cámaras de ese tipo. La analítica corre en el dispositivo, sin enviar video a un servidor para procesarlo.',
  },
  {
    q: '¿Cómo se integra el video con el audio IP para generar una respuesta automática?',
    a: 'Cuando la analítica detecta una condición, puede activar directamente un altavoz en el sector donde ocurrió el evento. La respuesta no es una sirena general sino un mensaje específico dirigido al área específica. Eso permite disuadir una intrusión, alertar a un operador que ingresó sin EPP, o notificar a un supervisor de una anomalía en línea, todo antes de que alguien tenga que moverse o revisar una pantalla.',
  },
  {
    q: '¿Qué son los metadatos de video y para qué sirven en una operación?',
    a: 'Los metadatos son los datos estructurados que genera la analítica a partir de lo que ve la cámara. No es el video en sí sino la información extraída, cuántas personas pasaron por un sector, cuánto tiempo estuvo un vehículo en la playa de descarga, en qué momento se detectó una condición de riesgo. Esos datos son livianos, se integran con cualquier sistema de gestión y se pueden visualizar en tableros en tiempo real. El video queda grabado como respaldo. Los metadatos son los que generan valor operativo.',
  },
  {
    q: '¿Qué hace falta en la red para que el sistema funcione en tiempo real?',
    a: 'La red tiene que estar dimensionada para soportar el tráfico de video y metadatos en condiciones de operación plena, no solo en la demostración. Eso implica ancho de banda suficiente en los uplinks entre switches, segmentación del tráfico de video en una VLAN separada del tráfico productivo, y enlaces de fibra en instalaciones perimetrales o con puntos alejados. Un cuello de botella en la red hace que las alertas lleguen tarde. En un sistema de detección, tarde puede ser demasiado tarde.',
  },
  {
    q: '¿Cómo se gestiona la ciberseguridad del sistema de video?',
    a: 'Las cámaras AXIS tienen firmware firmado digitalmente que se verifica en cada arranque. Ningún firmware no autorizado puede instalarse en el dispositivo. AXIS opera un programa de long term support con actualizaciones de seguridad gratuitas y un servicio de notificación de vulnerabilidades. Desde CamScope, las actualizaciones de firmware de toda la flota se ejecutan de forma centralizada. Y la red de videovigilancia se diseña segmentada del tráfico productivo para limitar el radio de impacto ante cualquier incidente.',
  },
  {
    q: '¿Qué es CamScope y qué diferencia tiene con un VMS genérico?',
    a: 'CamScope es la plataforma de gestión que Building Networks desarrolló a lo largo de diez años de operación en instalaciones industriales y corporativas. Centraliza la gestión de video, control de accesos y audio IP en una sola interfaz. No aplica licenciamiento por canal, lo que cambia completamente la ecuación de costo en instalaciones que escalan. Y permite ejecutar actualizaciones de firmware de cámaras y del propio sistema de forma centralizada, sin intervención manual dispositivo por dispositivo.',
  },
  {
    q: '¿Por qué AXIS y no otro fabricante?',
    a: 'AXIS diseña su propio procesador, el ARTPEC, lo que le da control total sobre las funciones de seguridad desde el nivel más bajo del hardware. Cada dispositivo incluye Edge Vault, un módulo criptográfico que protege las claves y certificados ante cualquier intento de manipulación. El ciclo de long term support está documentado y publicado públicamente. Y AXIS cumple con la certificación FIPS 140, el estándar de seguridad criptográfica exigido por agencias federales de Estados Unidos. Es el fabricante que mejor combina capacidad de analítica, ciberseguridad documentada y soporte de largo plazo.',
  },
  {
    q: '¿El sistema reemplaza al personal de seguridad o lo potencia?',
    a: 'Lo potencia. Una persona puede cubrir un área, no diez. La analítica cubre todas las zonas simultáneamente y filtra el ruido, solo genera un evento cuando detecta una condición real. El personal de seguridad recibe la alerta con información precisa del sector y actúa sobre algo concreto, en lugar de monitorear pantallas o responder a falsas alarmas constantes. En instalaciones con perímetros grandes o múltiples turnos, esa diferencia es significativa.',
  },
  {
    q: '¿Cuánto cuesta agregar cámaras cuando la operación crece?',
    a: 'Depende de cómo esté diseñado el sistema desde el principio. Si la red fue dimensionada para el crecimiento proyectado, agregar cámaras es sumar dispositivos. Si no, puede implicar rehacer parte de la infraestructura. CamScope no cobra licencia por cámara adicional, lo que elimina el costo de software que tienen otros sistemas en cada ampliación. El costo real de escalar se define en el diseño inicial, no en el momento de la ampliación.',
  },
  {
    q: '¿Cómo se actualiza el firmware de toda la flota?',
    a: 'Desde CamScope se ejecutan actualizaciones de firmware de forma centralizada sobre toda la flota, incluyendo tanto las cámaras AXIS como el propio sistema de gestión. Las actualizaciones se planifican y ejecutan desde un punto único. El cliente no tiene que hacer nada manualmente. Eso garantiza que el sistema se mantiene actualizado sin que la gestión del mantenimiento dependa de que alguien lo recuerde y lo priorice.',
  },
  {
    q: '¿Por dónde se empieza un proyecto?',
    a: 'Por un relevamiento. Antes de especificar una sola cámara, necesitamos entender qué tiene instalado tu operación hoy, qué información necesita que hoy no tiene, cuáles son las condiciones reales del entorno y cómo está la infraestructura de red. Desde ahí definimos cobertura, equipamiento, configuración de analítica e integración con los sistemas existentes. El relevamiento es el primer paso y es sin costo.',
  },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---
<BaseLayout
  title="Prototipo · Video inteligente con tienda"
  description="Prototipo interno. No es una página pública."
  canonical="/prototipo-ecommerce-vi-7c21/"
  noindex
>
  <!-- Sin JSON-LD de FAQPage: esta copia no debe competir con /video-inteligente/ en buscadores. -->

  <!-- Aviso permanente: que nadie confunda esta copia con la pagina real. -->
  <p class="proto-aviso">
    Prototipo interno · copia de <a href={withBase('/video-inteligente/')}>/video-inteligente/</a> con tienda ·
    catálogo y precios de prueba · no indexada
  </p>

  <!-- HERO -->
  <section class="vi-hero">
    <div class="container vi-hero__inner">
      <span class="hero-badge"><Icon name="camera" size={26} /></span>
      <p class="eyebrow" style="color:#bfe0dd">Servicios y productos</p>
      <h1>Video inteligente para empresas e industrias</h1>
      <p class="lead" style="color:rgba(255,255,255,0.92); max-width:640px">
        Detección, control operativo y seguridad integrados en un solo sistema.
      </p>
      <p style="color:rgba(255,255,255,0.85); max-width:680px">{OFERTA}</p>
      <p style="margin-top:1.4rem"><a class="btn btn--white" href="#equipamiento">Ver equipamiento</a></p>
    </div>
  </section>

  <!-- QUÉ HACE -->
  <section class="section">
    <div class="container vi-cambia">
      <div class="vi-cambia__video">
        <YouTube id="KmWChISU8Ww" title="AXIS, video más inteligente y más seguro en el trabajo" />
      </div>
      <div>
        <h2>Lo que cambia cuando el video es inteligente</h2>
        <ul class="vi-bullets">
          {beneficios.map((b) => (
            <li><Icon name="arrow" size={18} /><span>{b}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- PARA QUIÉN -->
  <section class="section section--surface">
    <div class="container">
      <div class="center measure mx-auto"><h2>Industrias y operaciones que lo usan</h2></div>
      <div class="vi-grid" style="margin-top:2.5rem">
        {sectores.map((s) => (
          <div class="card vi-card">
            <span class="card__icon"><Icon name={s.icono} size={32} /></span>
            <h3>{s.titulo}</h3>
            <p>{s.resumen}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================================
       E-COMMERCE · lo único que no existe en /video-inteligente/.
       Grilla filtrable + carrito. Sin backend: ver cabecera del archivo.
       ==================================================================== -->
  <section class="section tienda" id="equipamiento">
    <div class="container">
      <div class="center measure mx-auto">
        <p class="eyebrow">Equipamiento</p>
        <h2>Armá tu lista de equipos</h2>
        <p class="lead">
          Todo lo que ves acá se instala, configura e integra con CamScope como parte del
          servicio. Podés pedir una unidad o cien. El relevamiento sigue siendo el primer paso:
          la lista que armes es el punto de partida de la conversación, no el final.
        </p>
      </div>

      <div class="tienda__layout">
        <!-- FILTROS -->
        <aside class="tienda__filtros" aria-label="Filtros de catálogo">
          <div class="tienda__filtros-inner">
            <div class="filtro">
              <label class="filtro__label" for="f-buscar">Buscar</label>
              <input class="filtro__input" type="search" id="f-buscar" placeholder="Modelo, tipo, uso…" autocomplete="off" />
            </div>

            <fieldset class="filtro">
              <legend class="filtro__label">Categoría</legend>
              {CATEGORIAS.map((c) => (
                <label class="chk"><input type="checkbox" data-filtro="categoria" value={c.id} /> <span>{c.label}</span></label>
              ))}
            </fieldset>

            <fieldset class="filtro">
              <legend class="filtro__label">Entorno</legend>
              {ENTORNOS.map((e) => (
                <label class="chk"><input type="checkbox" data-filtro="entorno" value={e.id} /> <span>{e.label}</span></label>
              ))}
            </fieldset>

            <fieldset class="filtro">
              <legend class="filtro__label">Capacidad</legend>
              <label class="chk"><input type="checkbox" data-filtro="analitica" value="si" /> <span>Con analítica embebida</span></label>
            </fieldset>

            <div class="filtro">
              <label class="filtro__label" for="f-precio">Precio hasta <output id="f-precio-out"></output></label>
              <input class="filtro__rango" type="range" id="f-precio" min="0" max={precioMax} step="50000" value={precioMax} />
            </div>

            <button class="btn tienda__limpiar" type="button" id="f-limpiar">Limpiar filtros</button>
          </div>
        </aside>

        <!-- GRILLA -->
        <div class="tienda__main">
          <div class="tienda__barra">
            <p class="tienda__conteo" id="conteo" aria-live="polite"></p>
            <label class="tienda__orden">
              <span>Ordenar</span>
              <select id="f-orden">
                <option value="relevancia">Relevancia</option>
                <option value="precio-asc">Menor precio</option>
                <option value="precio-desc">Mayor precio</option>
                <option value="nombre">Nombre</option>
              </select>
            </label>
          </div>

          <div class="tienda__grid" id="grid">
            {productos.map((p) => (
              <article
                class="prod"
                data-sku={p.sku}
                data-categoria={p.categoria}
                data-entorno={p.entorno}
                data-analitica={p.analitica ? 'si' : 'no'}
                data-precio={p.precio}
                data-nombre={p.nombre}
                data-busca={`${p.nombre} ${p.modelo} ${p.ficha} ${p.tags.join(' ')}`.toLowerCase()}
              >
                <div class="prod__foto">
                  {p.imagen
                    ? <img src={p.imagen} alt={p.modelo} loading="lazy" width="800" height="800" />
