---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import { servicios } from '../data/servicios';
const s = servicios.find((x) => x.slug === 'audio-ip')!;
---
<ServiceLayout slug={s.slug} title={s.titulo} resumen={s.resumen} icono={s.icono}>
  <h2>Sistemas de audio sobre IP</h2>
  <p>
    Implementamos sistemas de audio IP innovadores, ideales para comunicación
    corporativa, seguridad y entretenimiento, conectados directamente a tus redes
    convergentes.
  </p>
  <h2>Aplicaciones</h2>
  <ul>
    <li>Avisos y comunicación corporativa en tiempo real.</li>
    <li>Mensajería de seguridad y evacuación.</li>
    <li>Música ambiental y entretenimiento por zonas.</li>
    <li>Integración con videovigilancia y control de accesos vía CamScope.</li>
  </ul>
</ServiceLayout>
