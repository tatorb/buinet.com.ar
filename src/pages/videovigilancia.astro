---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import { servicios } from '../data/servicios';
const s = servicios.find((x) => x.slug === 'videovigilancia')!;
---
<ServiceLayout slug={s.slug} title={s.titulo} resumen={s.resumen} icono={s.icono}>
  <h2>Protección en tiempo real</h2>
  <p>
    Integramos soluciones avanzadas de videovigilancia que te permiten supervisar
    remotamente, grabar y almacenar datos de manera eficiente y accesible. Trabajamos
    con tecnología de nuestro partner AXIS, líder mundial en cámaras y audio IP.
  </p>
  <h2>Qué incluye</h2>
  <ul>
    <li>Cámaras IP de alta resolución para empresas, edificios y barrios privados.</li>
    <li>Monitoreo remoto y acceso en tiempo real desde cualquier dispositivo.</li>
    <li>Grabación, almacenamiento y respaldo de imágenes.</li>
    <li>Analítica de video e integración con control de accesos y audio IP.</li>
    <li>Gestión centralizada a través de nuestro software propio CamScope.</li>
  </ul>
  <p>
    <!-- Texto detallado de la página real pendiente de completar desde el HTML capturado. -->
  </p>
</ServiceLayout>
