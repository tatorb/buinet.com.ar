---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
---
<BaseLayout
  title="Contacto"
  description="Contactá a Building Networks. Formulario de contacto, teléfono, email y coordinación de reunión con un asesor comercial. Córdoba, Argentina."
>
  <section class="svc-hero">
    <div class="container" style="padding-block:clamp(1.9rem,4.2vw,3.1rem)">
      <p class="eyebrow">Contacto</p>
      <h1 style="color:#fff">Hablemos de tu proyecto</h1>
      <p class="lead" style="color:var(--color-on-dark-muted); max-width:640px">
        Coordiná una reunión con un especialista o escribinos. Te respondemos a la brevedad.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contacto">
      <div class="contacto__info">
        <h2>Datos de contacto</h2>
        <p class="contacto__item"><Icon name="shield" size={18} /> <span><strong>{site.legalName}</strong><br />{site.address.street}<br />({site.address.zip}) {site.address.city} — {site.address.country}</span></p>
        <p class="contacto__item"><Icon name="arrow" size={18} /> <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="contacto__item"><Icon name="arrow" size={18} /> <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>

        <div class="card contacto__asesor">
          <span class="card__icon"><Icon name="calendar" /></span>
          <h3>Reunión con un asesor comercial</h3>
          <p>¿Te gustaría entender si podemos ayudarte? Coordinemos una reunión con un especialista.</p>
          <a class="btn" href={`mailto:${site.email}?subject=Reuni%C3%B3n%20con%20Asesor%20Comercial`} style="margin-top:0.75rem">
            Coordinar reunión <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>

      <div class="contacto__form card">
        <h2>Escribinos</h2>
        <!-- Formulario embebido de HubSpot (procesa el envío en HubSpot). -->
        <div id="hubspot-form"></div>
      </div>
    </div>
  </section>

  <script is:inline charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline>
    window.addEventListener('load', function () {
      if (window.hbspt) {
        hbspt.forms.create({
          portalId: '45351897',
          formId: '97d3db1d-fec8-41e4-9d92-88e606500dfe',
          region: 'na1',
          target: '#hubspot-form',
        });
      }
    });
  </script>
</BaseLayout>

<style>
  .svc-hero { background: linear-gradient(160deg, var(--navy-950), var(--navy-800)); }
  .contacto { display: grid; grid-template-columns: 1fr 1.3fr; gap: 3rem; align-items: start; }
  .contacto__item { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0.5rem 0; }
  .contacto__item svg { color: var(--color-accent); flex: none; margin-top: 4px; }
  .contacto__asesor { margin-top: 2rem; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field { display: grid; gap: 0.35rem; margin-bottom: 1rem; }
  .field label { font-weight: 600; font-size: 0.95rem; }
  .field input, .field textarea { padding: 0.75rem 0.9rem; border: 1px solid var(--color-border); border-radius: 10px; font: inherit; width: 100%; background: var(--color-surface); }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--color-accent); background: #fff; box-shadow: 0 0 0 3px rgba(22,165,224,0.15); }
  @media (max-width: 820px) { .contacto { grid-template-columns: 1fr; } .grid2 { grid-template-columns: 1fr; } }
</style>
