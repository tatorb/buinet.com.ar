---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtFecha = (d: Date) =>
  d.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post section">
    <div class="container post__inner">
      <p class="post__meta">
        <span>{fmtFecha(post.data.pubDate)}</span>
        {post.data.category && <span> · {post.data.category}</span>}
        {post.data.author && <span> · {post.data.author}</span>}
      </p>
      <h1>{post.data.title}</h1>
      <div class="post__body prose">
        <Content />
      </div>
      <p class="post__back"><a href="/blog/">← Volver al blog</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .post__inner { max-width: 760px; }
  .post__meta { color: var(--color-muted); font-size: 0.95rem; text-transform: capitalize; }
  .post__body { margin-top: 1.5rem; }
  .prose :global(h2) { margin-top: 2rem; }
  .prose :global(img) { border-radius: var(--radius); margin-block: 1.5rem; }
  .prose :global(pre) { background: var(--color-surface); padding: 1rem; border-radius: 8px; overflow-x: auto; }
  .post__back { margin-top: 2.5rem; }
</style>
