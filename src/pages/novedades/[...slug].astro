---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <section class="svc-hero">
    <div class="container" style="padding-block:clamp(2.5rem,6vw,4rem); max-width:820px">
      <p class="eyebrow">Novedades</p>
      <h1 style="color:#fff">{post.data.title}</h1>
      <p class="post__meta">
        {fmt(post.data.pubDate)}{post.data.category ? ` · ${post.data.category}` : ''}{post.data.author ? ` · ${post.data.author}` : ''}
      </p>
    </div>
  </section>

  <article class="section">
    <div class="container post__inner prose">
      <Content />
      <p class="post__back"><a href="/novedades/"><Icon name="arrow" size={16} /> Volver a Novedades</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .svc-hero { background: linear-gradient(160deg, var(--navy-950), var(--navy-800)); }
  .post__meta { color: var(--color-on-dark-muted); font-size: 0.95rem; text-transform: capitalize; margin: 0; }
  .post__inner { max-width: 720px; }
  .prose :global(h2) { margin-top: 2rem; }
  .prose :global(img) { border-radius: var(--radius); margin-block: 1.5rem; }
  .prose :global(pre) { background: var(--color-surface); padding: 1rem; border-radius: 8px; overflow-x: auto; }
  .post__back { margin-top: 2.5rem; }
  .post__back a { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; }
</style>
