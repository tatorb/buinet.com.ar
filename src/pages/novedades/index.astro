---
import { withBase } from '../../utils/url';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const fmt = (d: Date) => d.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title="Novedades" description="Novedades y noticias sobre Building Networks, nuestros partners y la industria de las redes convergentes.">
  <section class="svc-hero">
    <div class="container" style="padding-block:clamp(1.9rem,4.2vw,3.1rem)">
      <p class="eyebrow">Novedades</p>
      <h1 style="color:#fff">Últimas novedades</h1>
      <p class="lead" style="color:var(--color-on-dark-muted); max-width:640px">
        Noticias sobre nuestra propuesta, nuestros partners y la industria en general.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p>Todavía no hay artículos publicados. Se importarán desde la base de datos salvada.</p>
      ) : (
        <div class="grid grid--3">
          {posts.map((post) => (
            <a class="card card--link post-card" href={withBase(`/${post.id}/`)}>
              {post.data.heroImage && (
                <img class="post-card__img" src={post.data.heroImage} alt={post.data.title} loading="lazy" />
              )}
              <div class="post-card__body">
                <p class="card__date">{fmt(post.data.pubDate)}</p>
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
                <span class="card__more">Leer más <Icon name="arrow" size={16} /></span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .svc-hero { background: linear-gradient(160deg, rgba(0,70,75,0.86), rgba(0,98,105,0.66)), url("/wp-content/uploads/2024/07/A3.jpg") center/cover no-repeat; }
  .card__date { color: var(--color-accent-dark); font-size: 0.85rem; font-weight: 600; margin: 0 0 0.35rem; text-transform: capitalize; }
  /* Tarjeta de novedad con imagen destacada arriba */
  .post-card { padding: 0; overflow: hidden; text-align: left; align-items: stretch; }
  .post-card__img { width: 100%; height: 190px; object-fit: cover; background: var(--color-surface); }
  .post-card__body { padding: 1.6rem; display: flex; flex-direction: column; height: 100%; }
  .post-card__body h3 { margin-bottom: 0.5rem; }
  .post-card__body p { color: var(--color-muted); }
  .post-card .card__more { margin-top: auto; padding-top: 1rem; }
  .card__more { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--teal); font-weight: 500; font-size: 0.9rem; }
</style>
