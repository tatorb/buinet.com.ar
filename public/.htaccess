# ============================================================================
#  .htaccess — Building Networks (sitio estático Astro)
#  Servidores Apache (o Apache como backend detrás de nginx en HestiaCP).
#  En un stack nginx-puro este archivo se ignora: ver reglas equivalentes
#  para nginx en docs/redirects-410.md.
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --------------------------------------------------------------------------
  # 410 GONE — URLs de spam inyectadas por un hackeo previo (cloaking).
  # Google indexó ~1.000 URLs falsas tipo:
  #   /?shop/c/c82294/   /?shop/goods/W822665/   /shop/...   /goods/...
  # Devolvemos 410 (NO 404, NO 301, NO 200) para que Google las elimine del
  # índice de forma permanente. [G]=Gone(410) [L]=última regla [NC]=sin caso.
  # --------------------------------------------------------------------------

  # 1) Query string que arranca con "shop" o "goods"  (ej: /?shop/c/c82294/)
  RewriteCond %{QUERY_STRING} (^|&)shop [OR,NC]
  RewriteCond %{QUERY_STRING} (^|&)goods [NC]
  RewriteRule ^ - [G,L]

  # 2) Path que arranca con /shop/ o /goods/  (ej: /shop/ , /goods/lo-que-sea)
  RewriteRule ^shop(/.*)?$  - [G,L,NC]
  RewriteRule ^goods(/.*)?$ - [G,L,NC]

  # ==========================================================================
  #  REDIRECCIONES 301 — ÚNICO LUGAR DEL PROYECTO
  #  Todas las redirecciones del sitio se definen acá y en ningún otro lado.
  #  NO agregar la opción "redirects" en astro.config.mjs: definirlas en dos
  #  lugares genera conflictos y Astro solo produce un meta refresh (HTTP 200),
  #  mientras que estas reglas devuelven un 301 real, que es lo que Google
  #  necesita para transferir el posicionamiento de la URL vieja a la nueva.
  # ==========================================================================

  # Artículo movido: el post ahora vive en la raíz, no bajo /novedades/.
  RewriteRule ^novedades/que-es-un-data-center/?$ /que-es-un-data-center-capitalinas/ [R=301,L]

  # Landings del sitio anterior que ya no existen.
  RewriteRule ^data-center-cordoba/?$ /data-center/ [R=301,L]
  RewriteRule ^camaras-ip-axis-para-industrias-a/?$ /videovigilancia-industrial/ [R=301,L]
  RewriteRule ^camaras-ip-axis-para-industrias-formulario/?$ /contacto/ [R=301,L]
  RewriteRule ^presentacion-de-caso-de-exito-distrito-capitalinas/?$ /videovigilancia/ [R=301,L]

  # Duplicado: consolida la variante "la-base" en la canónica "esencial-hoy-en-dia".
  RewriteRule ^que-es-una-red-convergente-y-por-que-es-la-base/?$ /que-es-una-red-convergente-y-por-que-es-esencial-hoy-en-dia/ [R=301,L]
</IfModule>
